{
  "name": "sprout-hollow-valley",
  "version": "1.2.7",
  "description": "A cozy third-person low-poly 3D farming and life-simulation adventure across an authored open valley.",
  "license": "MIT",
  "author": "DingDingChae",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ding-Ding-Projects/sprout-hollow-valley.git"
  },
  "homepage": "https://github.com/Ding-Ding-Projects/sprout-hollow-valley#readme",
  "bugs": {
    "url": "https://github.com/Ding-Ding-Projects/sprout-hollow-valley/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run build:main && vite build && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build:icon": "node scripts/build-app-icon.mjs",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build:icon && npm run build && electron-builder --win squirrel --publish never",
    "shots": "node scripts/render-shots.mjs",
    "count": "node scripts/count-lines.mjs",
    "check:build": "node scripts/check-build-config.mjs",
    "dish": "node scripts/dish-name.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.185.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "com.dingdingprojects.sprouthollowvalley",
    "productName": "Sprout Hollow Valley",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "executableName": "SproutHollowValley",
      "icon": "assets/branding/sprout-hollow-valley.ico",
      "target": [
        "squirrel"
      ],
      "signAndEditExecutable": true,
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "squirrelWindows": {
      "artifactName": "Sprout-Hollow-Valley-Setup-${version}.${ext}",
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/sprout-hollow-valley/6550c8c33e663f22f1c88f182807178c5b5f09ff/assets/branding/sprout-hollow-valley.ico",
      "msi": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ding-Ding-Projects",
        "repo": "sprout-hollow-valley",
        "releaseType": "release"
      }
    ],
    "forceCodeSigning": false
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
